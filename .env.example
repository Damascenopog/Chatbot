# Copy this file to .env and replace every placeholder before starting the stack.
POSTGRES_USER=evolution
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=evolution

EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-a-random-api-key

N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-a-random-encryption-key

# --- Chatwoot ---
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_SECRET_KEY_BASE=replace-with-a-64-character-hex-string
CHATWOOT_ENABLE_ACCOUNT_SIGNUP=true

NOME_EMPRESA=IMPORPLAY
WHATSAPP_ATENDENTE=replace-with-attendant-number
MENU_BANNER_URL=https://res.cloudinary.com/drvcmlax/image/upload/f_auto,q_auto/Promo%C3%A7%C3%A3o_Imporplay__Entretenimento_Completo
